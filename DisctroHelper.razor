### TAX RATE CHECK ###
# We wanted to have a simple way for the guild master to toggle which items go into the distro.
# The script will check for the relevant items locked down on the ground. 
# If those items are found, they will not be distributed.

if findtype 3827 ground 2609 1 6 as switch //Arcane-scrolls
    getlabel switch lbl
    if "locked down" in lbl
        @setvar! taxPinkScrolls 1
        sysmsg "Locked down Arcane Scroll found, taxing arcane scrolls." 818
    endif
else 
    @setvar! taxPinkScrolls 0
endif

if findtype 17087 ground 0 1 6 as switch //master-crafting-diagram
    getlabel switch lbl
    if "locked down" in lbl
        @setvar! taxMCDs 1
        sysmsg "Locked down Master Crafting Diagram found, taxing MCDs." 818
    endif
else 
    @setvar! taxMCDs 0
endif

