### BANK CLEANING ###

@setvar! bank 0
#finding a banker to open the bank box
sysmsg "searching for banker npcs" 818
while findtype 401|400 ground -1 -1 15 as npc
    getlabel npc lbl
    if "banker" in lbl
        sysmsg "{{lbl}}" 43
        say "bank"
        // Razor does not allow detection of the bank gump and ID, it needs to be set explicitly.
        if varexist YDH_Bankbox_ID
            //good, we can check for loot in the bank
            //sort loot
            if findtype 3705 backpack 38 -1 -1 as trappedpouch
                lift trappedpouch
                drop YDH_Bankbox_ID
                foreach x in Bank_Loot_Types_List
                    sysmsg "Bank_Loot_Types_List" 818
                    while findtype x YDH_Bankbox_ID -1 -1 -1 as loot
                        getlabel loot lbl
                        sysmsg "{{lbl}}" 818
                        lift loot 60000
                        drop trappedpouch
                        @ignore loot
                    endwhile
                endfor
                overhead "Cleaning done, cast recall and take the pouch on your cursor."
            else 
                sysmsg "No trapped pouch found in backpack."
                stop
            endif
            stop
        else 
            overhead "Banker found, bankboxID found. Please set Bankbox ID"
            stop
        endif
        break
    else 
        sysmsg "{{lbl}}" 818
    endif
    @ignore npc
endwhile
@clearignore 

