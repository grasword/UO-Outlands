### finding a DROPBOX
### finding small paragon chest and checking access
if findtype 2472 ground -1 1 2
    sysmsg "Checking nearby paragon boxes for access" 14
endif

@clearignore 
while findtype 2472 ground -1 1 2 as parabox
    getlabel parabox clbl
    sysmsg "found parabox {{clbl}}" 818
    if inlist YDH_accessible_boxes parabox
        //checked before
        sysmsg "{{parabox}} {{clbl}} already checked accessible" 818
    elseif inlist YDH_secure_boxes parabox  
        sysmsg "{{parabox}} {{clbl}} already checked inaccessible" 43
    else
        sysmsg "we need to check access to {{clbl}}" 818
        dclick parabox
        if findtype 3705 backpack 38 as test
            #|3617|5370|3974|3973|3980|3852|3847|3851
            #use trapped pouch, a bandage, a reagent or a potion to test access
            getlabel test lbl
            sysmsg "found {{test}} {{lbl}}" 818
            if "(0 items, 0 stones)" in lbl
                sysmsg "using empty trapped pouch to test access" 818
                lift test
                wait 500
                drop parabox
                wait 500
                if find test backpack
                    sysmsg "{{parabox}} {{clbl}} inaccessible" 43
                    pushlist YDH_secure_boxes parabox
                else 
                    sysmsg "{{parabox}} {{clbl}} accessible" 818
                    pushlist YDH_accessible_boxes parabox
                    dclick parabox
                    wait 250
                    lift test
                    drop self
                    wait 500
                    lift test
                    drop self
                    wait 500
                endif
            else 
                sysmsg "no trapped pouch found for testing access" 43
                stop
            endif
        else 
            sysmsg "no trapped pouch for testing found" 43
        endif
    endif
    @ignore parabox 
endwhile

