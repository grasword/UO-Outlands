                waitforgump 4045111101
                gumpresponse 7
                waitforgump 4045111101
                gumpresponse 6
                waitforgump 4045111101
                gumpresponse 6
                waitforgump 4045111101
                gumpclose
                menu 'recycler' 1
                wait 1000
            endif
        endif
else
    sysmsg 'ITEM RECYCLER NOT FOUND.' 818 
    //stop
endif


