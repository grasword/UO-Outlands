### CUTTING UP SHOES into RARE CLOTH

if YDH_dropbox != 0 and find YDH_dropbox ground -1 1 2
    dclick YDH_dropbox
    wait 250
    while findtype 5899|5903|5905|5901 YDH_dropbox as myshoes
        getlabel myshoes lbl
        sysmsg "found shoes: {{lbl}}"
        lift myshoes 1
        wait 200
        drop self -1 -1 -1
        wait 500
    endwhile
endif
    
while findtype 5899|5903|5905|5901 backpack as myshoes
    getlabel myshoes lbl
    sysmsg "found shoes: {{lbl}}" 818
    if "blessed" in lbl
        @ignore myshoes
    else 
        if findtype 3999 as myscissors
            dclick myscissors
            wft 1000
            target myshoes
            wait 250
        else 
            sysmsg "no scissors found to cut up boots for rare cloth" 43
        endif
    endif
endwhile



