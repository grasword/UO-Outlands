sysmsg "Moving TAX items from Backpack, Ground and Dropbox to storage" 44
foreach loottype in Tax_Types_List
    while findtype loottype backpack as loot
        if YDH_showitems = 1
            getlabel loot lbl
            sysmsg "{{lbl}}" 818
        endif
        lift loot 60000
        wait 400
        if YDH_tax_storage != 0
            drop YDH_tax_storage -1 -1 -1
        elseif YDH_dropbox != 0
            drop YDH_dropbox -1 -1 -1
        elseif YDH_distro != 0
            drop YDH_distro -1 -1 -1
        else
            drop self -1 -1 -1
        endif
        @ignore loot
    endwhile
    while findtype loottype ground -1 1 2 as loot
        if YDH_showitems = 1
            getlabel loot lbl
            sysmsg "{{lbl}}" 818
        endif
        if "[locked down]" in lbl
            //sysmsg "{{loot}} {{lbl}}"
        else 
            lift loot 60000
            wait 400
            if YDH_tax_storage != 0
                drop YDH_tax_storage -1 -1 -1
            elseif YDH_dropbox != 0
                drop YDH_dropbox -1 -1 -1
            elseif YDH_distro != 0
                drop YDH_distro -1 -1 -1
            else
                drop self -1 -1 -1
            endif
        endif
        @ignore loot
    endwhile
    while findtype loottype YDH_dropbox -1 1 2 as loot
        if YDH_showitems = 1
            getlabel loot lbl
            sysmsg "{{lbl}}" 818
        endif
        if YDH_tax_storage != 0
            lift loot 60000
            wait 400
            drop YDH_tax_storage -1 -1 -1
        else 
            sysmsg "skipped due to no tax storage access" 818
        endif
        @ignore loot
    endwhile
endfor

