dclick BDONCOmain
wait 500

#Arcane rune tome
@setvar! BDORuneTome 0
if storeArcaneRunes = 1
    if CFC_RuneTome != 0 and find CFC_RuneTome BDONCOmain
        @setvar! BDORuneTome CFC_RuneTome
    elseif findtype 70158 BDONCOmain 2085 as runetome
        @setvar! BDORuneTome runetome
    else
        overhead 'ARCANE RUNE TOME NOT FOUND' 44
    endif
endif

# Arcane Runes to the Rune Tome in NCO main chest
if BDORuneTome != 0 and findtype 'rune' backpack
    overhead 'Putting away boss runes...' 44
    menu BDORuneTome 0
endif

#NCO resources chest
if CFC_NCOresources != 0 and find CFC_NCOresources BDONCOmain
    @setvar BDONCOresources CFC_NCOresources
elseif not varexist BDONCOresources or not find BDONCOresources BDONCOmain
    while not find BDONCOresources BDONCOmain
        overhead "Select NCO resources chest"
        @setvar BDONCOresources
    endwhile
endif

#Boss token container, tokens go to NCO main if it is not found
@setvar! BDOTokens BDONCOmain
if CFC_Tokens != 0
    if find CFC_Tokens BDONCOmain or find CFC_Tokens ground -1 -1 2
        @setvar! BDOTokens CFC_Tokens
    else
        overhead 'TOKEN CONTAINER NOT FOUND, tokens go to NCO main' 44
    endif
endif

