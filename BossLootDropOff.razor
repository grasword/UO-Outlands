sysmsg "Dropping Rares into Distrochest" 14
foreach itemtype in rarelist
    while findtype itemtype backpack as item
        @clearsysmsg 
        getlabel item lbl
        sysmsg "{{item}} {{lbl}}" 818
        lift item 60000
        wait 200
        drop BDODistro -1 -1 -1
        wait 500
        if insysmsg "That container cannot hold more items."
            if BDODistro = BDODistroOne
                sysmsg "Distro One full, switching to Distro two."
                @setvar BDODistro BDODistroTwo
            elseif BDODistro = BDODistroTwo
                sysmsg "Distro Two full, switching to Distro three."
                @setvar BDODistro BDODistroThree
            elseif BDODistro = BDODistroThree
                overhead "All Distros full!"
                stop
            endif
        endif
    endwhile
    while findtype itemtype BDOInbox as item
        getlabel item lbl
        sysmsg "{{item}} {{lbl}}" 818
        lift item 60000
        wait 200
        drop BDODistro -1 -1 -1
        wait 500
        if insysmsg "That container cannot hold more items."
            if BDODistro = BDODistroOne
                sysmsg "Distro One full, switching to Distro two."
                @setvar BDODistro BDODistroTwo
            elseif BDODistro = BDODistroTwo
                sysmsg "Distro Two full, switching to Distro three."
                @setvar BDODistro BDODistroThree
            elseif BDODistro = BDODistroThree
                overhead "All Distros full!"
                stop
            endif
        endif
    endwhile
endfor    

