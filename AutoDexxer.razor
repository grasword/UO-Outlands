@setvar! goldAmountToDrop 1000

@setvar! jaseowns_UseAbilityTimerCD 5000
@setvar! jaseowns_UseAbility1 1
@setvar! jaseowns_UseAbility2 0
@setvar! jaseowns_UseAbility3 0

if not timerexists jaseowns_UseAbility1Timer
    settimer jaseowns_UseAbility1Timer 30000
endif

if not timerexists jaseowns_UseAbility2Timer
    settimer jaseowns_UseAbility2Timer 30000
endif

if not timerexists jaseowns_UseAbility3Timer
    settimer jaseowns_UseAbility3Timer 30000
endif

@setvar! jaseowns_ParalyzeTimerCD 2000
if not timerexists jaseowns_ParalyzeTimer
    settimer jaseowns_ParalyzeTimer jaseowns_ParalyzeTimerCD
endif

if findtype 8454 backpack or findtype 8455 backpack or findtype 43206 backpack or findtype 5363 backpack or findtype "rare cloth tome" backpack or findtype "dyes tome" backpack or findtype "ship upgrade tome" backpack or findtype "lore page tome" backpack or findtype "collectable card tome" backpack or findtype "spell scroll tome" backpack or findtype "treasure map tome" backpack or findtype "skill mastery tome" backpack or findtype "fishing map tome" backpack or findtype "lumber map tome" backpack or findtype "ore map tome" backpack or findtype "skinning map tome" backpack or findtype "aspect item tome" backpack or findtype "arcane rune tome" backpack or findtype "chain link tome" backpack or findtype "chain link" backpack
    overhead "VALUABLE ON YOU! CHECK YOU BACKPACK! DO NOT IGNORE THIS MESSAGE U STUPID! VALUABLE ON YOU! VALUABLE ON YOU!" 37
    sysmsg "VALUABLE ON YOU! CHECK YOU BACKPACK! DO NOT IGNORE THIS MESSAGE U STUPID! VALUABLE ON YOU! VALUABLE ON YOU!" 37
endif

while not dead
    if paralyzed and timer jaseowns_ParalyzeTimer >= jaseowns_ParalyzeTimerCD
        if findtype "pouch" backpack 38 as item
            yell "[pouch"
            settimer jaseowns_ParalyzeTimer 0
        else
            overhead "Out of pouches!" 34
        endif
    endif
    
    if weight > maxweight
        if findtype "gold coin" backpack as item
            lift item goldAmountToDrop
            droprelloc 0 0
            wait 200
            if insysmsg "cannot drop anything"
                drop backpack -1 -1 -1
            endif
            clearsysmsg
            wait 650
        else
            overhead "We are overweight but cannot drop anything" 34
        endif
    endif
    

    if not bandaging
        if hp < maxhp or poisoned or findbuff "disease" or findbuff "bleed"
            if findtype "clean bandage%s%" backpack
                if targetexists
                    hotkey "cancel current target"
                endif
                hotkey "Bandage Self"
                wait 250
            else
                overhead "Out of bandages!" 34
            endif
        endif
    endif
    
    if jaseowns_UseAbility1 = 1 and timer jaseowns_UseAbility1Timer >= jaseowns_UseAbilityTimerCD
        say "[WeaponAbility1"
        getlabel backpack jaseowns_PingCheck
        if insysmsg "You do cannot perform that ability yet."
            settimer jaseowns_UseAbility1Timer 0
        elseif insysmsg "You have not yet unlocked that weapon ability."
            @setvar! jaseowns_UseAbility1 0
        else
            settimer jaseowns_UseAbility1Timer 0
        endif
        clearsysmsg
    endif

    if jaseowns_UseAbility2 = 1 and timer jaseowns_UseAbility2Timer >= jaseowns_UseAbilityTimerCD
        say "[WeaponAbility2"
        getlabel backpack jaseowns_PingCheck
        if insysmsg "You do cannot perform that ability yet."
            settimer jaseowns_UseAbility2Timer 0
        elseif insysmsg "You have not yet unlocked that weapon ability."
            @setvar! jaseowns_UseAbility2 0
        else
            settimer jaseowns_UseAbility2Timer 0
        endif
        clearsysmsg
    endif
    
    if jaseowns_UseAbility3 = 1 and timer jaseowns_UseAbility3Timer >= jaseowns_UseAbilityTimerCD
        say "[WeaponAbility3"
        getlabel backpack jaseowns_PingCheck
        if insysmsg "You do cannot perform that ability yet."
            settimer jaseowns_UseAbility3Timer 0
        elseif insysmsg "You have not yet unlocked that weapon ability."
            @setvar! jaseowns_UseAbility3 0
        else
            settimer jaseowns_UseAbility3Timer 0
        endif
        clearsysmsg
    endif
    
    wait 50

endwhile