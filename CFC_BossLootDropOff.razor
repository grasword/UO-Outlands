### MOVE LOOT ###
# Every item type is taken from your backpack first, then from the CFC Public Chest.

# Arcane runes from your backpack into the rune tome
if BDORuneTome != 0 and findtype 'rune' backpack
    overhead 'Putting away boss runes...' 44
    menu BDORuneTome 0
endif

# Distro loot -> Distro One, switching to Distro Two when One is full
@setvar BDODistro BDODistroOne
sysmsg "Dropping distro loot into the distro" 14
foreach itemtype in distroLootList
    while findtype itemtype backpack as item
        @clearsysmsg
        getlabel item lbl
        sysmsg "{{item}} {{lbl}}" 818
        lift item 60000
        wait 200
        drop BDODistro -1 -1 -1
        wait 500
        if insysmsg "That container cannot hold more items."
            if BDODistro = BDODistroOne
                sysmsg "Distro One full, switching to Distro Two" 44
                @setvar BDODistro BDODistroTwo
            elseif BDODistro = BDODistroTwo
                overhead "All distros full!" 44
                stop
            endif
        endif
    endwhile

    while findtype itemtype BDOPublicChest as item
        @clearsysmsg
        getlabel item lbl
        sysmsg "{{item}} {{lbl}}" 818
        lift item 60000
        wait 200
        drop BDODistro -1 -1 -1
        wait 500
        if insysmsg "That container cannot hold more items."
            if BDODistro = BDODistroOne
                sysmsg "Distro One full, switching to Distro Two" 44
                @setvar BDODistro BDODistroTwo
            elseif BDODistro = BDODistroTwo
                overhead "All distros full!" 44
                stop
            endif
        endif
    endwhile
endfor

