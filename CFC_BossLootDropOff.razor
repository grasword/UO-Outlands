    sysmsg "Checking the distros for items that must not be handed out" 14
    foreach itemtype in nonDistroList
        while findtype itemtype BDODistroOne as item
            getlabel item lbl
            sysmsg "{{item}} {{lbl}}" 818
            lift item 60000
            wait 200
            if itemtype = 17083 or itemtype = 5192
                drop BDOTokens -1 -1 -1
            else
                drop BDONCOmain -1 -1 -1
            endif
            wait 500
            @ignore item
        endwhile

        while findtype itemtype BDODistroTwo as item
            getlabel item lbl
            sysmsg "{{item}} {{lbl}}" 818
            lift item 60000
            wait 200
            if itemtype = 17083 or itemtype = 5192
                drop BDOTokens -1 -1 -1
            else
                drop BDONCOmain -1 -1 -1
            endif
            wait 500
            @ignore item
        endwhile
    endfor

    while findtype 5356 BDODistroOne 2091 as item
        getlabel item lbl
        sysmsg "{{item}} {{lbl}}" 818
        lift item 60000
        wait 200
        drop BDONCOmain -1 -1 -1
        wait 500
        @ignore item
    endwhile

    while findtype 5356 BDODistroTwo 2091 as item
        getlabel item lbl
        sysmsg "{{item}} {{lbl}}" 818
        lift item 60000
        wait 200
        drop BDONCOmain -1 -1 -1
        wait 500
        @ignore item
    endwhile

    sysmsg "Check complete" 14

    # Arcane runes: out of the CFC Public Chest into your backpack, then into the rune tome
    while findtype 39889|39891|39892|39896|39897|39898|39905|39909|39911|39912|39916|39917|39918 BDOPublicChest as myrune
        lift myrune 10
        if findtype 3702 backpack as mybag
            drop mybag 100 100
        else
            drop self -1 -1 -1
        endif
        @ignore myrune
    endwhile

    if BDORuneTome != 0
        menu BDORuneTome 0
    endif

    # Hand out the loot once the CFC Public Chest is empty, otherwise start over
    getlabel BDOPublicChest lbl
    if "(0 items" in lbl
        say '[bossresults'
        waitforgump 1892293155
        dclick BDODistroOne
        waitforgump 2865667423
    else
        sysmsg "CFC Public Chest not empty, restarting" 14
        @clearignore
        replay
    endif
endif
