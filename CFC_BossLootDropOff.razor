pushlist distroLootList 17686|4026 //aspect-distillations
pushlist distroLootList 22336 //skill-orbs
pushlist distroLootList 8826 //skill-scrolls
pushlist distroLootList 37181 //survival-gear

if taxMCDs = 0
    pushlist distroLootList 17087 //master-crafting-diagrams
endif

if taxRMs = 0
    pushlist distroLootList 24434 //research-materials
endif

pushlist distroLootList 11858 //spell-hue-deeds
pushlist distroLootList 51098 //dungeon-seeds
pushlist distroLootList 29025 //furniture-dye
pushlist distroLootList 29034 //mastery-chain-dye
pushlist distroLootList 3842 //headwear-dye
pushlist distroLootList 3838 //runebook-dye
pushlist distroLootList 3839 //backpack-dye
pushlist distroLootList 48407|4248|43165|43166 //carpet-tiles
pushlist distroLootList 5360 //checks
pushlist distroLootList 3821 //gold-coins
pushlist distroLootList 3891 //doubloons

if debug = 1
    pushlist distroLootList 4225 //leather-for-testing
endif

# Mini-rares: go to Distro Two
removelist miniRareList
createlist miniRareList

if taxPinkScrolls = 0
    pushlist miniRareList 3827 //arcane-scrolls-pink-hue-2609
endif

pushlist miniRareList 29030 //plant-chemicals
pushlist miniRareList 576 //phylacteries
pushlist miniRareList 29036 //carpet-dye
pushlist miniRareList 51094 //melloweed-leaves
pushlist miniRareList 15296 //mount-gear-dye

# Maps: go to the distro one at a time (legendary T8 maps are moved to NCO main first)
removelist mapList
createlist mapList
pushlist mapList 70148 //fishing-map
pushlist mapList 70151 //lumber-map
pushlist mapList 70154 //ore-map
pushlist mapList 70157 //skinning-map
pushlist mapList 5356 //treasure-map

# Resources: go to NCO resources
removelist resourceList
createlist resourceList
pushlist resourceList 515|2422|2426|2489|2496|2515|2545|5639|5641|7708|7711|17617|17619 //raw-food
pushlist resourceList 4225 //leather
pushlist resourceList 7154 //ingots
pushlist resourceList 7127 //boards
pushlist resourceList 22326 //seeds

# Boss tokens: go to the Boss tokens container
removelist tokenList
createlist tokenList
pushlist tokenList 17083 //mini-boss-token
pushlist tokenList 5192 //main-boss-token

# Tax items: go to NCO main
removelist taxList
createlist taxList
pushlist taxList 3901 //arcane-essence
pushlist taxList 43206 //mastery-chain-links

if taxMCDs = 1
    pushlist taxList 17087 //master-crafting-diagrams
endif

if taxRMs = 1
    pushlist taxList 24434 //research-materials
endif

if taxPinkScrolls = 1
    pushlist taxList 3827 //arcane-scrolls-pink
endif

# Everything that must never stay in a distro (checked by the verify step)
removelist nonDistroList
createlist nonDistroList
foreach entry in resourceList
    pushlist nonDistroList entry
endfor

foreach entry in tokenList
    pushlist nonDistroList entry
endfor

foreach entry in taxList
    pushlist nonDistroList entry
endfor

### RECYCLER ###
# Unidentified magic items go into the recycler, which is emptied when full.

if findtype '57484|57495|11761|11762' true as 'recycler'
    sysmsg 'Depositing unidentified items...' 14
    menu 'recycler' 1
    wait 1000
    if autoRecycle = 1
        getlabel recycler reclabel
        overhead reclabel 53
        if "(125 items," in reclabel
            overhead "Recycler full" 44
            dclick recycler
            wait 500
            waitforgump 4045111101
            gumpresponse 7
            waitforgump 4045111101
            gumpresponse 6
            waitforgump 4045111101
            gumpresponse 6
            waitforgump 4045111101
            gumpclose
            menu 'recycler' 1
            wait 1000
        endif
    endif
else
    sysmsg 'ITEM RECYCLER NOT FOUND. STOPPING.' 44
    stop
endif

### CONTAINER SETUP ###
# Uses the serial from CONTAINERS when that chest is in range. Otherwise uses the
# chest picked on an earlier run (BDO... variables), or asks you to target it.

# Distro One
if CFC_DistroOne != 0 and find CFC_DistroOne ground -1 -1 2
    @setvar BDODistroOne CFC_DistroOne
elseif not varexist BDODistroOne or not find BDODistroOne ground -1 -1 2
    overhead 'Select Distro One'
    hotkey 'Clear Target Queue'
    @setvar BDODistroOne
    wft 500
    while targetexists
        wait 100
    endwhile

    getlabel BDODistroOne lbl
    if find BDODistroOne ground any any 2 and 'distribution chest' in lbl
        wait 500
        overhead 'Distro One set!' 14
        dclick BDODistroOne
        wait 500
    else
        overhead 'Wrong chest or too far away!' 44
        replay
    endif
endif

# Distro Two
if CFC_DistroTwo != 0 and find CFC_DistroTwo ground -1 -1 2
    @setvar BDODistroTwo CFC_DistroTwo
elseif not varexist BDODistroTwo or not find BDODistroTwo ground -1 -1 2
    overhead 'Select Distro Two'
    hotkey 'Clear Target Queue'
    @setvar BDODistroTwo
    wft 500
    while targetexists
        wait 100
    endwhile

    getlabel BDODistroTwo lbl
    if find BDODistroTwo ground any any 2 and 'distribution chest' in lbl
        wait 500
        overhead 'Distro Two set!' 14
        dclick BDODistroTwo
        wait 500
    else
        overhead 'Wrong chest or too far away!' 44
        replay
    endif
endif

# CFC Public Chest
if CFC_PublicChest != 0 and find CFC_PublicChest ground -1 -1 2
    @setvar BDOPublicChest CFC_PublicChest
elseif not varexist BDOPublicChest or not find BDOPublicChest ground -1 -1 2
    overhead 'Select CFC Public Chest'
    hotkey 'Clear Target Queue'
    @setvar BDOPublicChest
    wft 500
    while targetexists
        wait 100
    endwhile

    if find BDOPublicChest ground any any 2
        overhead 'CFC Public Chest set!' 14
        dclick BDOPublicChest
        wait 500
    else
        overhead 'Wrong chest or too far away!' 44
        replay
    endif
endif

# NCO main
if CFC_NCOmain != 0 and find CFC_NCOmain ground -1 -1 2
    @setvar BDONCOmain CFC_NCOmain
elseif not varexist BDONCOmain or not find BDONCOmain ground -1 -1 2
