endif


//
// ---- Add Tokens to Lists ----
//
#Open token parent containers only if necessary
#For example, you have not opened the chests since logging in
if counttype 5192 MainTokenBag 1182 == 0
    if find 0x43CA95A7 ground -1 1 2
        dclick 0x43CA95A7
        wait 500
        dclick 0x4E46D762
        wait 500
        dclick MainTokenBag
        wait 500
        dclick MiniTokenBag
        wait 500
    endif
endif

if find 0x43CA920D ground -1 1 2 as topchest
    dclick topchest
    while findtype 5192 topchest as token
        lift token
        drop MainTokenBag
    endwhile
    while findtype 17083 topchest as token
        lift token
        drop MiniTokenBag
    endwhile
endif

