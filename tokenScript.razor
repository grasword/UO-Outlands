@clearignore

//
// ---- Variables ----
//
setvar! RedSpeechHue 37
setvar! YelSpeechHue 53
setvar! GrnSpeechHue 72

@setvar! MainTokenBag 0x5DDDD1FF
@setvar! MiniTokenBag 0x5DDDE5F3


//
// ---- Initilizations ----
//
if not listexists "TokensList"
    createlist "TokensList"
else
